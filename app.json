{
  "expo": {
    "name": "Графік змін",
    "slug": "work-planner",
    "scheme": "workplanner",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "platforms": ["android"],

    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ],

    "android": {
      "package": "com.workplanner.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/png/icon-app.png",
        "backgroundColor": "#0A2F46"
      }
    }
  }
}
