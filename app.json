{
  "expo": {
    "name": "Графік змін",
    "slug": "work-planner",
    "scheme": "workplanner",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/png/icon-app.png",
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "android": {
      "package": "com.workplanner.app",
      "icon": "./src/assets/png/icon-app.png"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
